{
  "name": "acme-secured-card",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Secured credit card service: collateral, activation, spending, repayments, billing",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/migrate.ts",
    "token": "tsx scripts/token.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run test/unit.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "check:ai-logs": "node scripts/check-ai-logs.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
